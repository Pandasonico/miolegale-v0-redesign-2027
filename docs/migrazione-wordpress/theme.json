{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "90rem"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "primary", "name": "Blu MioLegale", "color": "#1e5192" },
        { "slug": "ink", "name": "Navy", "color": "#173f71" },
        { "slug": "foreground", "name": "Testo", "color": "#10223d" },
        { "slug": "background", "name": "Bianco", "color": "#ffffff" },
        { "slug": "secondary", "name": "Grigio azzurro", "color": "#eff3f9" },
        { "slug": "muted-foreground", "name": "Testo secondario", "color": "#5a6a82" },
        { "slug": "accent", "name": "Azzurro tenue", "color": "#dbe7f6" },
        { "slug": "border", "name": "Bordo", "color": "#e1e7ef" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "IBM Plex Sans",
          "fontFamily": "'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "IBM Plex Sans", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/ibm-plex-sans.woff2"] }
          ]
        },
        {
          "slug": "reading",
          "name": "Public Sans",
          "fontFamily": "'Public Sans', ui-sans-serif, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Public Sans", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/public-sans.woff2"] }
          ]
        },
        {
          "slug": "mono",
          "name": "Monospazio di sistema",
          "fontFamily": "ui-monospace, 'SFMono-Regular', Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Piccolo", "size": "0.875rem" },
        { "slug": "base", "name": "Base", "size": "1rem" },
        { "slug": "reading", "name": "Lettura", "size": "1.0625rem" },
        { "slug": "large", "name": "Grande", "size": "1.125rem" },
        { "slug": "x-large", "name": "Titolo sezione", "size": "1.5rem" }
      ]
    },
    "spacing": {
      "units": ["rem", "px", "%"]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--background)", "text": "var(--wp--preset--color--foreground)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "lineHeight": "1.5" },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } }
    }
  }
}
